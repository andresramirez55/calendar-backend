{
  "services": [
    {
      "name": "calendar-backend",
      "source": "./back",
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "./calendar-backend",
        "healthcheckPath": "/health"
      }
    },
    {
      "name": "calendar-frontend",
      "source": "./front",
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start",
        "healthcheckPath": "/"
      }
    }
  ]
}
